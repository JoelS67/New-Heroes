<!doctype html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <div class="site-noise" aria-hidden="true"></div>
  <div id="topo"></div>
  <%- include('partials/topbar') %>
  <%- include('partials/drawer') %>

  <main id="conteudo">
    <section class="hero" aria-labelledby="heroTitle">
      <div class="hero-art" role="img" aria-label="Heróis enfrentam uma batalha diante dos prédios da cidade"></div>
      <div class="hero-shade"></div>
      <div class="hero-content page-wrap">
        <p class="eyebrow"><span></span> UM UNIVERSO DE RP ORIGINAL</p>
        <h1 id="heroTitle">O mundo precisa<br>de novos <em>heróis.</em></h1>
        <p class="hero-intro">Grandes poderes não escrevem uma história sozinhos. Suas escolhas, alianças e conflitos é que mudam tudo.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/historia">DESCUBRA O UNIVERSO <span aria-hidden="true">↗</span></a>
          <a class="text-link" href="/personagens">CONHEÇA OS PERSONAGENS <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="hero-caption"><span>NEW HEROES</span><span>THE FIRST STEPS · 001</span></div>
      <a class="scroll-cue" href="#explorar" aria-label="Descer para explorar"><span></span> ROLE PARA EXPLORAR</a>
    </section>

    <section class="intro-section page-wrap" id="explorar">
      <div class="section-label"><span>01</span> UM NOVO COMEÇO</div>
      <div class="intro-copy">
        <h2>Uma cidade.<br><em>Mil possibilidades.</em></h2>
        <p>New Heroes: The First Steps é um universo de interpretação de personagens feito para criar histórias em conjunto. Heróis, civis e figuras à margem da lei dividem o mesmo mundo — e cada escolha pode abrir um novo caminho.</p>
        <a class="arrow-link" href="/historia">ENTENDA O UNIVERSO <span>↗</span></a>
      </div>
      <div class="intro-stamp" aria-hidden="true"><span>NH</span><small>THE<br>FIRST<br>STEPS</small></div>
    </section>

    <section class="explore-section">
      <div class="page-wrap">
        <div class="section-heading">
          <div><div class="section-label"><span>02</span> ENTRE NA HISTÓRIA</div><h2>Por onde começar?</h2></div>
          <p>Explore os pontos de partida e encontre o seu lugar neste universo.</p>
        </div>
        <div class="feature-grid">
          <a class="feature-card feature-story" href="/historia"><span class="feature-number">01 / LORE</span><div><h3>O universo</h3><p>Conheça a premissa e o cenário do RP.</p><span class="feature-arrow">↗</span></div></a>
          <a class="feature-card feature-map" href="/mapa"><span class="feature-number">02 / LOCAIS</span><div><h3>O mapa</h3><p>Descubra lugares para a sua próxima cena.</p><span class="feature-arrow">↗</span></div></a>
          <a class="feature-card feature-characters" href="/personagens"><span class="feature-number">03 / ELENCO</span><div><h3>Os personagens</h3><p>Veja os caminhos que você pode seguir.</p><span class="feature-arrow">↗</span></div></a>
        </div>
      </div>
    </section>

    <section class="season-teaser page-wrap">
      <div class="season-art" role="img" aria-label="Arte azul de New Heroes com a silhueta de uma equipe"></div>
      <div class="season-teaser-copy"><div class="section-label"><span>03</span> PRIMEIRO ARCO</div><p class="eyebrow">TEMPORADA 01</p><h2>Os Primeiros<br><em>Passos</em></h2><p>Toda grande jornada começa com uma decisão. Descubra o ponto de partida da primeira temporada.</p><a class="button button-light" href="/temporada">VER TEMPORADA <span>↗</span></a></div>
    </section>

    <section class="art-strip page-wrap" aria-label="Artes do universo New Heroes">
      <div class="art-strip-heading"><div class="section-label"><span>04</span> VISUAL DO UNIVERSO</div><p>Uma prévia das artes que dão vida a este mundo.</p></div>
      <div class="art-thumbnails"><img src="/assets/comic-action.jpg" alt="Confronto entre heróis em uma rua da cidade" loading="lazy"><img src="/assets/hero-blue.jpg" alt="Arte azul de identidade visual com silhuetas de heróis" loading="lazy"><img src="/assets/hero-family.jpg" alt="Equipe de heróis reunida em um momento descontraído" loading="lazy"></div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
