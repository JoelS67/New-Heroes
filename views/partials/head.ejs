<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="<%= typeof site !== 'undefined' && site ? site.backgroundColor : '#071522' %>">
<meta name="description" content="<%= typeof page !== 'undefined' && page && page.description ? page.description : 'Conheça o universo, as histórias e a comunidade de New Heroes: The First Steps.' %>">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : `${typeof site !== 'undefined' && site ? site.name : 'New Heroes'} — Portal` %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
